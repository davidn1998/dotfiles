#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DOTFILES_DIR"

echo "🚀 Bootstrapping dotfiles..."

OS="$(uname -s)"
echo "🖥 Detected OS: $OS"
echo ""

# ---------------------------
# 1. OS-specific packages
# ---------------------------
if [[ "$OS" == "Darwin" ]]; then
  bash scripts/macos.sh
elif [[ "$OS" == "Linux" ]]; then
  bash scripts/linux.sh
else
  echo "❌ Unsupported OS: $OS"
  exit 1
fi

echo ""

# ---------------------------
# 2. Node (nvm + LTS)
# ---------------------------
bash scripts/node.sh

echo ""

# ---------------------------
# 3. Dotfiles linking
# ---------------------------
bash scripts/stow.sh

echo ""

# ---------------------------
# 4. Validation
# ---------------------------
echo "🔍 Verifying install..."

check() {
  command -v "$1" >/dev/null 2>&1 && echo "✔ $1" || echo "❌ $1 missing"
}

check brew
check git
check stow
check nvim
check eza
check zoxide
check starship

echo ""
echo "🎉 Bootstrap complete!"
echo "👉 Restart your terminal or run: exec zsh"
