#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DOTFILES_DIR"

echo "🚀 Bootstrapping dotfiles..."

OS="$(uname -s)"
echo "🖥 Detected OS: $OS"
echo ""

# ---------------------------
# 1. Homebrew
# ---------------------------
if ! command -v brew >/dev/null 2>&1; then
  echo "📦 Installing Homebrew..."

  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# IMPORTANT: make brew available immediately (this was your main failure point)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

echo "🍺 Brew ready: $(brew --version | head -n 1)"
echo ""

# ---------------------------
# 2. Core tools via Brewfile
# ---------------------------
echo "📦 Installing Brew bundle..."
brew bundle --file mac/Brewfile

echo ""

# ---------------------------
# 3. Ensure stow exists
# ---------------------------
if ! command -v stow >/dev/null 2>&1; then
  echo "❌ stow missing after brew install"
  exit 1
fi

# ---------------------------
# 4. Dotfiles linking (safe + repeatable)
# ---------------------------
echo "🔗 Stowing dotfiles..."

stow -R zsh
stow -R git
stow -R nvim

echo ""

# ---------------------------
# 5. Shell environment refresh safety
# ---------------------------
export DOTFILES="$DOTFILES_DIR"

# ---------------------------
# 6. Validation layer (THIS is what makes it foolproof)
# ---------------------------
echo "🔍 Verifying install..."

check() {
  command -v "$1" >/dev/null 2>&1 && echo "✔ $1" || echo "❌ $1 missing"
}

check brew
check git
check stow
check nvim
check eza
check zoxide
check starship

echo ""
echo "🎉 Bootstrap complete!"
echo "👉 Restart your terminal or run: exec zsh"
